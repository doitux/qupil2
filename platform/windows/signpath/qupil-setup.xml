<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "qupil-setup": the Windows setup (Inno Setup), uploaded as Qupil-Setup.exe.
     The GitHub artifact is a ZIP with the file at its root (.github/workflows/desktop.yml).
     Product name and version must match (SignPath Foundation conditions); the workflow
     passes the version from CMakeLists.txt as parameter "version". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Qupil-Setup.exe" product-name="Qupil" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
